pipeline {
    agent any
    options {
        buildDiscarder(logRotator(numToKeepStr: '12'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
    }
    triggers {
        cron('H 9 1 * *') // Monthly on 1st at ~9am
    }
    environment {
        FREEE_COMPANY_ID = '10799541'
        FREEE_CLIENT_ID = '634466446256351'
        FREEE_TOKEN_PATH = "${env.HOME}/.config/gmail-fetcher/freee_token.json"
    }
    stages {
        stage('Setup') {
            steps {
                checkout scm
                sh 'pnpm install --frozen-lockfile'
                sh 'pnpm -r build'
            }
        }
        stage('Tax Audit') {
            steps {
                withCredentials([
                    string(credentialsId: 'freee-client-secret', variable: 'FREEE_CLIENT_SECRET'),
                    string(credentialsId: 'anthropic-api-key', variable: 'ANTHROPIC_API_KEY'),
                ]) {
                    sh '''
                        RECEIPT_DIR=receipts/incoming \
                        node packages/tax-audit/dist/index.js \
                            tax-audit-report.md --monthly --vision || true
                    '''
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'tax-audit-report.md', allowEmptyArchive: true
            script {
                if (fileExists('tax-audit-report.md') && env.GOOGLE_CHAT_WEBHOOK) {
                    def lines = readFile('tax-audit-report.md').split('\n')
                    def summary = lines[0..Math.min(14, lines.length - 1)].join('\n')
                    def payload = groovy.json.JsonOutput.toJson([text: "*[freee] 月次税務監査レポート*\n${summary}\n\nJenkins: ${env.BUILD_URL}"])
                    sh "curl -s -X POST '${env.GOOGLE_CHAT_WEBHOOK}' -H 'Content-Type: application/json' -d '${payload}'"
                } else if (currentBuild.result == 'FAILURE' && env.GOOGLE_CHAT_WEBHOOK) {
                    def payload = groovy.json.JsonOutput.toJson([text: "*[freee] 月次税務監査 FAILED*\n${env.BUILD_URL}"])
                    sh "curl -s -X POST '${env.GOOGLE_CHAT_WEBHOOK}' -H 'Content-Type: application/json' -d '${payload}'"
                }
            }
            sh '''
                if [ -f tax-audit-report.md ]; then
                    PERIOD=$(date +%Y-%m)
                    DEST="$HOME/Google Drive/My Drive/freee-reports/tax-audit-${PERIOD}.md"
                    mkdir -p "$(dirname "$DEST")"
                    cp tax-audit-report.md "$DEST"
                fi
            '''
            cleanWs()
        }
    }
}
